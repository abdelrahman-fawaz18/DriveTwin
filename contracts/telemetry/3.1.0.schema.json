{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:telemetry:3.1.0",
  "title": "Simulation monitoring scalar observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "event_id",
    "asset_id",
    "source_id",
    "session_id",
    "stream_seq",
    "run_id",
    "mode",
    "observed_at",
    "clock_domain",
    "sim_time_s",
    "samples",
    "source_epoch",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "catalog_version": {
      "const": "1.3.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "stream_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "const": "simulation"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "clock_domain": {
      "const": "simulation"
    },
    "sim_time_s": {
      "type": "number",
      "minimum": 0
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "value",
          "unit",
          "quality",
          "provenance"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "quality": {
            "enum": [
              "good",
              "invalid",
              "missing"
            ]
          },
          "provenance": {
            "enum": [
              "simulated-observation"
            ]
          },
          "raw_value": {
            "type": "number"
          },
          "reason": {
            "enum": [
              "sensor_fault",
              "out_of_range",
              "nonfinite",
              "dropout"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "quality": {
                  "const": "good"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                },
                "reason": false,
                "raw_value": false
              }
            },
            "else": {
              "required": [
                "reason"
              ],
              "properties": {
                "value": {
                  "type": "null"
                },
                "reason": {
                  "enum": [
                    "sensor_fault",
                    "out_of_range",
                    "nonfinite",
                    "dropout"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "quality": {
                  "const": "missing"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "const": "dropout"
                },
                "raw_value": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "quality": {
                  "const": "invalid"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "enum": [
                    "sensor_fault",
                    "out_of_range",
                    "nonfinite"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "annotations": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,31}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
