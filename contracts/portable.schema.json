{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:profile:p0-portable:1.0.0",
  "type": "object",
  "properties": {
    "asset_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
    "event_id": {"$ref": "#/$defs/uuid"},
    "session_id": {"$ref": "#/$defs/uuid"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "stream_seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "observed_at": {
      "type": "string", "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z(?![\\s\\S])"
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"}
  }
}
