{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:command:execution-result:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "run_id", "asset_id", "attempt_sim_s", "status"],
  "properties": {
    "schema_version": {"const": "evdt-command-execution/1.0.0"},
    "command_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
    "attempt_sim_s": {"type": "number", "minimum": 0},
    "status": {"enum": ["acknowledged", "unknown_outcome"]}
  }
}
