{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:command:speed-limit:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "run_id", "asset_id", "mode", "issuer", "capability", "parameters", "reason", "issued_at", "expires_at", "not_before_sim_s", "expires_sim_s"],
  "properties": {
    "schema_version": {"const": "evdt-command/1.0.0"},
    "command_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "asset_id": {"$ref": "#/$defs/name"},
    "mode": {"const": "simulation"},
    "issuer": {"$ref": "#/$defs/name"},
    "capability": {"const": "set_speed_limit"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "minimum": 2, "maximum": 5},
        "unit": {"const": "m/s"}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
    "issued_at": {"$ref": "#/$defs/utc"},
    "expires_at": {"$ref": "#/$defs/utc"},
    "not_before_sim_s": {"type": "number", "minimum": 0},
    "expires_sim_s": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"}
  }
}
