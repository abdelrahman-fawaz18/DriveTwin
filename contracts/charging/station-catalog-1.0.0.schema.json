{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:charging:station-catalog:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "mission_id", "stations"],
  "properties": {
    "schema_version": {"const": "evdt-charging-stations/1.0.0"},
    "catalog_id": {"$ref": "#/$defs/name"},
    "mission_id": {"$ref": "#/$defs/name"},
    "stations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/station"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id", "location_class", "longitude", "latitude", "approach",
        "connector_ids", "power_per_bay_w", "charge_efficiency",
        "bay_count", "queue_capacity", "status_max_age_sim_s"
      ],
      "properties": {
        "station_id": {"$ref": "#/$defs/name"},
        "location_class": {"const": "hypothetical"},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "approach": {"$ref": "#/$defs/approach"},
        "connector_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "power_per_bay_w": {"type": "integer", "minimum": 1},
        "charge_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "bay_count": {"type": "integer", "minimum": 1},
        "queue_capacity": {"type": "integer", "minimum": 0},
        "status_max_age_sim_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "start_m", "end_m"],
      "properties": {
        "lane_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "start_m": {"type": "number", "minimum": 0},
        "end_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
