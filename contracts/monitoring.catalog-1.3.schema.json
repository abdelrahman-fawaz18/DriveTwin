{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evdt:catalog:monitoring:1.3.0",
  "type": "object",
  "required": [
    "catalog_version",
    "assets",
    "signals"
  ],
  "properties": {
    "catalog_version": {
      "enum": [
        "1.3.0"
      ]
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "unit",
          "minimum",
          "maximum"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "data_type": {
            "const": "number"
          }
        }
      }
    }
  }
}
