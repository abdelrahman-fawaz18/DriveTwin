{
  "version": "motor-input-contract/1.0.0",
  "bench_winding_prediction": {
    "profile_split": "qualification/thermal/motor-profile-split-1.0.0.json",
    "sample_period_s": 0.5,
    "time_origin": "sample 0 within each profile",
    "inputs": {
      "ambient": {"source_unit": "degC", "model_unit": "K", "transform": "value + 273.15"},
      "coolant": {"source_unit": "degC", "model_unit": "K", "transform": "value + 273.15"},
      "motor_speed": {"source_unit": "rpm", "model_unit": "rad/s", "transform": "value * 2 * pi / 60"},
      "current_squared_proxy": {"source_columns": ["i_d", "i_q"], "source_unit": "A", "model_unit": "A^2", "transform": "i_d^2 + i_q^2"}
    },
    "primary_target": {"column": "stator_winding", "source_unit": "degC", "model_unit": "K", "transform": "value + 273.15"},
    "primary_initial_state": "measured stator_winding at sample 0, once per profile",
    "secondary_initial_state": "ambient at sample 0, reported separately",
    "rollout": "input row k advances state to k+1, starting with k=0, using predicted state after initialization",
    "score_first_sample_index": 1,
    "scoring_input_exclusions": ["stator_winding after initialization", "stator_tooth", "stator_yoke", "pm", "u_d", "u_q", "torque", "profile_id", "future rows"],
    "metadata_only": {"profile_id": "partition and session reset", "torque": "operating-regime description in N.m"},
    "fitting_partition": "train",
    "model_selection_partition": "validation",
    "final_scoring_partition": "test"
  },
  "simulated_bus_boundary": {
    "scope": "separate modeled bus study with independent synthetic scenarios and parameters",
    "base_catalog": "catalog/monitoring-signals.json",
    "available_input_candidates": {
      "ambient.temperature": {"unit": "K", "period_s": 1, "role": "assumed heat sink boundary"},
      "traction.motor.speed": {"unit": "rad/s", "period_s": 1, "role": "calculated aggregate shaft-speed proxy"},
      "traction.motor.torque": {"unit": "N.m", "period_s": 1, "role": "calculated aggregate torque proxy with low-speed rule"}
    },
    "available_temperature_observation": {"id": "traction.motor.temperature", "unit": "K", "period_s": 1, "role": "single assumed aggregate observation"},
    "second_bus_only_boundary": {"id": "coolant.inlet.temperature", "catalog": "catalog/monitoring-coolant-1.3.0.json", "unit": "K", "period_s": 2, "role": "assumed inlet boundary"},
    "unsupported_bench_equivalents": ["motor-axis voltage and current", "winding, tooth, yoke and magnet temperatures", "measured coolant flow and pump response"]
  }
}
