{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "declaration": true, "outDir": ".build", "rootDir": "src",
    "lib": ["ES2022", "DOM"], "skipLibCheck": false, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
