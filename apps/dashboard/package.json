{
  "name": "@evdt/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo:dev": "vite --config vite.demo.config.mjs",
    "demo:build": "tsc --noEmit && vite build --config vite.demo.config.mjs",
    "demo:preview": "vite preview --config vite.demo.config.mjs",
    "design:dev": "vite --config vite.preview.config.mjs",
    "design:build": "tsc --noEmit && vite build --config vite.preview.config.mjs",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src tests index.html replay.html preview.html demo.html vite.preview.config.mjs vite.demo.config.mjs vite.config.mjs package.json tsconfig.json",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
